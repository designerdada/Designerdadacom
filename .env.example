# Environment Variables
# Copy this file to .env.local and fill in your values.

# --- Convex (written to .env.local automatically by `npx convex dev`) ---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- Publishing: Convex calls this site's /api/revalidate after publishing ---
# Set the SAME value in Convex: npx convex env set REVALIDATE_SECRET <value>
REVALIDATE_SECRET=generate_with_node_-e_"console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Photography (optional) ---
# Cloudflare Worker API URL. Use http://localhost:8787 for local development.
NEXT_PUBLIC_WORKER_API_URL=http://localhost:8787

# --- AutoSend newsletter ---
AUTOSEND_API_KEY=as_your_key_here
AUTOSEND_NEWSLETTER_LIST_ID=your_list_id_here
NEWSLETTER_TOKEN_SECRET=generate_with_node_-e_"console.log(require('crypto').randomBytes(32).toString('hex'))"

# Convex deployment env vars (set with `npx convex env set`, not in this file):
#   SITE_URL             https://www.yourdomain.com (http://localhost:3000 for dev)
#   ADMIN_EMAIL          the only email allowed to sign in to /admin (magic link)
#   AUTOSEND_API_KEY     sends the sign-in email (without it, localhost prints the link to the Convex logs)
#   JWT_PRIVATE_KEY, JWKS  generated by `npx @convex-dev/auth`
#   REVALIDATE_SECRET    same value as above
