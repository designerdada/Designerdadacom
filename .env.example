# Environment Variables
# Copy this file to .env and fill in your values

# Cloudflare Worker API URL (for photography feature)
# Use http://localhost:8787 for local development
# Use your deployed worker URL for production
VITE_WORKER_API_URL=http://localhost:8787

# R2 Public URL (for photography feature)
# Your Cloudflare R2 bucket's public URL or custom domain
VITE_R2_PUBLIC_URL=https://your-r2-bucket.r2.dev

# AutoSend — newsletter feature
AUTOSEND_API_KEY=as_your_key_here
AUTOSEND_API_URL=https://api.autosend.com/v1
AUTOSEND_FROM_EMAIL=you@yourdomain.com
AUTOSEND_FROM_NAME=Your Name
AUTOSEND_NEWSLETTER_LIST_ID=your_list_id_here
AUTOSEND_TEMPLATE_ID=your_template_id_here
NEWSLETTER_TOKEN_SECRET=generate_with_node_-e_"console.log(require('crypto').randomBytes(32).toString('hex'))"
